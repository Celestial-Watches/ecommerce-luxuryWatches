        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nentity \&quot;Customer\&quot; {\n    + CustomerID : int &lt;&lt;PK&gt;&gt;\n    + Name : string\n    + Email : string\n    + Password : string\n    + PhoneNumber : string\n    + Address : string\n    + MembershipStatus : string\n}\n\nentity \&quot;AdminUser\&quot; {\n    + AdminUserID : int &lt;&lt;PK&gt;&gt;\n    + Name : string\n    + Email : string\n    + Password : string\n}\n\nentity \&quot;Product\&quot; {\n    + ProductID : int &lt;&lt;PK&gt;&gt;\n    + Name : string\n    + Description : string\n    + Price : decimal\n    + StockQuantity : int\n    + CategoryID : int &lt;&lt;FK&gt;&gt;\n    + Brand : string\n    + ImageURL : string\n}\n\nentity \&quot;Category\&quot; {\n    + CategoryID : int &lt;&lt;PK&gt;&gt;\n    + CategoryName : string\n    + ParentCategoryID : int &lt;&lt;FK&gt;&gt; (nullable)\n}\n\nentity \&quot;Order\&quot; {\n    + OrderID : int &lt;&lt;PK&gt;&gt;\n    + CustomerID : int &lt;&lt;FK&gt;&gt;\n    + OrderDate : date\n    + TotalAmount : decimal\n    + PaymentStatus : string\n    + ShippingStatus : string\n}\n\nentity \&quot;OrderItem\&quot; {\n    + OrderItemID : int &lt;&lt;PK&gt;&gt;\n    + OrderID : int &lt;&lt;FK&gt;&gt;\n    + ProductID : int &lt;&lt;FK&gt;&gt;\n    + Quantity : int\n    + PriceAtPurchase : decimal\n}\n\nentity \&quot;Review\&quot; {\n    + ReviewID : int &lt;&lt;PK&gt;&gt;\n    + ProductID : int &lt;&lt;FK&gt;&gt;\n    + CustomerID : int &lt;&lt;FK&gt;&gt;\n    + Rating : int\n    + Comment : string\n    + ReviewDate : date\n}\n\nentity \&quot;Payment\&quot; {\n    + PaymentID : int &lt;&lt;PK&gt;&gt;\n    + OrderID : int &lt;&lt;FK&gt;&gt;\n    + PaymentDate : date\n    + PaymentMethod : string\n    + Amount : decimal\n    + PaymentStatus : string\n}\n\nentity \&quot;Wishlist\&quot; {\n    + WishlistID : int &lt;&lt;PK&gt;&gt;\n    + CustomerID : int &lt;&lt;FK&gt;&gt;\n    + CreatedDate : date\n}\n\nentity \&quot;WishlistItem\&q